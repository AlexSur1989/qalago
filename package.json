{
  "name": "qalago",
  "version": "0.0.0",
  "private": true,
  "description": "QalaGo — городской super-app для Казахстана",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev:infra": "docker compose -f infra/docker/docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f infra/docker/docker-compose.dev.yml down",
    "dev:api": "npm run start:dev -w @qalago/catalog-api",
    "dev:api:seed": "npm run seed -w @qalago/catalog-api",
    "dev:admin": "npm run dev -w @qalago/admin-web",
    "dev:business": "npm run dev -w @qalago/business-web",
    "dev:ai": "npm run start:dev -w @qalago/ai-orchestrator",
    "dev:all": "powershell -ExecutionPolicy Bypass -File scripts/dev/start-all.ps1",
    "staging:up": "docker compose -f infra/docker/docker-compose.staging.yml --env-file infra/env/.env.staging.example up -d --build",
    "staging:down": "docker compose -f infra/docker/docker-compose.staging.yml down",
    "staging:seed": "docker compose -f infra/docker/docker-compose.staging.yml exec api npx prisma db push && docker compose -f infra/docker/docker-compose.staging.yml exec api npm run seed"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
