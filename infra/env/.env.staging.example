# QalaGo — local Docker staging (copy and adjust if needed)
# Used by: npm run staging:up
# NODE_ENV=production + QALAGO_ENV=STAGING — weaker localhost CORS / OTP_DEBUG allowed for QA only.

QALAGO_ENV=STAGING
POSTGRES_PASSWORD=qalago_staging
JWT_SECRET=qalago-staging-jwt-secret-min-32-chars
OTP_DEBUG=true
DEV_LOGIN_ENABLED=false
MOCK_PLAN_CHECKOUT_ENABLED=false
AI_INTEGRATION_ENABLED=false
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:8080
