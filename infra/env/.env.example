# QalaGo — development environment (template)
# Copy to services/catalog-api/.env when API is created.
# NEVER commit real secrets.

NODE_ENV=development
PORT=3002

DATABASE_URL="postgresql://qalago:qalago_dev@localhost:5432/qalago_dev?schema=public"

JWT_SECRET="change-me-min-32-chars-dev-only"
JWT_EXPIRES_IN="7d"

# OTP: never enable debug in production
OTP_DEBUG=false

# DEV passwordless login — NEVER enable in production
DEV_LOGIN_ENABLED=false

# Auth method flags (Stage 6.2)
OTP_AUTH_ENABLED=true
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_WEB=
GOOGLE_AUTH_IP_LIMIT=20
GOOGLE_AUTH_IP_WINDOW_SECONDS=900
APPLE_AUTH_ENABLED=false
APPLE_CLIENT_ID_IOS=
APPLE_CLIENT_ID_WEB=
SOCIAL_AUTH_IP_LIMIT=20
SOCIAL_AUTH_IP_WINDOW_SECONDS=900

# Mock subscription checkout — development/test only; blocked in production
MOCK_PLAN_CHECKOUT_ENABLED=false

# OTP rate limits (production-safe defaults)
OTP_SEND_COOLDOWN_SECONDS=60
OTP_SEND_PHONE_LIMIT=5
OTP_SEND_PHONE_WINDOW_SECONDS=3600
OTP_SEND_IP_LIMIT=20
OTP_SEND_IP_WINDOW_SECONDS=3600
OTP_VERIFY_MAX_ATTEMPTS=5
OTP_VERIFY_WINDOW_SECONDS=900

# Public analytics ingest abuse protection
ANALYTICS_EVENTS_IP_LIMIT=300
ANALYTICS_EVENTS_WINDOW_SECONDS=60

# Business onboarding rate limits (per user, sliding window)
BUSINESS_APPLICATION_CREATE_LIMIT=5
BUSINESS_APPLICATION_CREATE_WINDOW_SECONDS=3600
BUSINESS_APPLICATION_SUBMIT_LIMIT=10
BUSINESS_APPLICATION_SUBMIT_WINDOW_SECONDS=3600
OWNERSHIP_CLAIM_CREATE_LIMIT=5
OWNERSHIP_CLAIM_CREATE_WINDOW_SECONDS=3600

# Redis (phase 2 — OTP storage, queues)
REDIS_URL="redis://localhost:6379"

# Default city for MVP
DEFAULT_CITY_SLUG=uralsk

# CORS (comma-separated origins for web panels + mobile web)
CORS_ORIGINS="http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:8080"

# Uploads (local dev)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=5

# S3 (production — leave empty in dev)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# AI orchestrator (internal service auth — server-side only)
AI_ORCHESTRATOR_URL=http://localhost:3004
QALAGO_INTERNAL_SERVICE_TOKEN=dev-internal-service-token-change-me
