# QalaGo — development environment (template)
# Copy to services/catalog-api/.env when API is created.
# NEVER commit real secrets.

NODE_ENV=development
PORT=3002

DATABASE_URL="postgresql://qalago:qalago_dev@localhost:5432/qalago_dev?schema=public"

JWT_SECRET="change-me-min-32-chars-dev-only"
JWT_EXPIRES_IN="7d"

# OTP: never enable debug in production
OTP_DEBUG=false

# Redis (phase 2 — OTP storage, queues)
REDIS_URL="redis://localhost:6379"

# Default city for MVP
DEFAULT_CITY_SLUG=uralsk

# CORS (comma-separated origins for web panels + mobile web)
CORS_ORIGINS="http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:8080"

# Uploads (local dev)
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=5

# S3 (production — leave empty in dev)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# AI orchestrator (future)
# AI_ORCHESTRATOR_URL=http://localhost:3001
# LLM_API_KEY=
