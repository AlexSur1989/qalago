# QalaGo — production environment contract (template only)
# Copy to a host-specific secret store / .env.production on the VPS (never commit real values).
# Canonical matrix: docs/infra/production-environment.md

# Runtime profile — required for public production deploy
NODE_ENV=production
QALAGO_ENV=PRODUCTION
PORT=3000

# Database — required; no localhost; use managed Postgres connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/qalago?schema=public

# Auth secrets — required; min 32 chars; no placeholders
JWT_SECRET=GENERATE_STRONG_SECRET_MIN_32_CHARS
# Access token TTL (canonical default in code: 20m). Refresh sessions: REFRESH_TOKEN_EXPIRES_DAYS (default 30).
JWT_EXPIRES_IN=20m
REFRESH_TOKEN_EXPIRES_DAYS=30

# Dev-only flags — must remain false
OTP_DEBUG=false
DEV_LOGIN_ENABLED=false
TEST_AUTH_BYPASS_ENABLED=false
MOCK_PLAN_CHECKOUT_ENABLED=false

# Auth methods — at least one must be true
OTP_AUTH_ENABLED=true
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_WEB=
APPLE_AUTH_ENABLED=false
APPLE_CLIENT_ID_IOS=
APPLE_CLIENT_ID_WEB=

# CORS — HTTPS origins only; no wildcard; no localhost
CORS_ORIGINS=https://admin.example.com,https://business.example.com,https://www.example.com

# Public web base URLs (catalog-api server-side links, invites, emails)
CONSUMER_WEB_BASE_URL=https://www.example.com
BUSINESS_WEB_BASE_URL=https://business.example.com

DEFAULT_CITY_SLUG=uralsk

# Geocoding — mock provider forbidden in strict production
QALAGO_GEOCODING_PROVIDER=maptiler
MAPTILER_API_KEY=

# Redis — optional until PROD.5; empty disables distributed rate limits
REDIS_URL=

# Uploads — local disk until PROD.3 object storage
UPLOAD_DIR=/app/services/catalog-api/uploads
MAX_UPLOAD_MB=5

# Object storage placeholders (PROD.3 — do not wire yet)
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# AI orchestrator — disable until deployed, or set strong internal token
AI_INTEGRATION_ENABLED=false
AI_ORCHESTRATOR_URL=http://ai-orchestrator:3000
QALAGO_INTERNAL_SERVICE_TOKEN=

# Staff MFA — set strong key before STAFF_MFA_REQUIRED=true
STAFF_MFA_REQUIRED=false
STAFF_MFA_ENCRYPTION_KEY=

# Push — requires Firebase Admin credentials when enabled
PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Next.js apps (build-time / runtime public — set per app, not in API .env)
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
# NEXT_PUBLIC_QALAGO_PUBLIC_BASE_URL=https://www.example.com
# NEXT_PUBLIC_CONSUMER_WEB_URL=https://www.example.com

# SMS provider — not selected; real SMS is a future stage (no vendor env names yet)
