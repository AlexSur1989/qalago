generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  BUSINESS
  CITY_ADMIN
  ADMIN
  SUPER_ADMIN
}

enum AuthProvider {
  GOOGLE
  APPLE
}

enum BusinessMembershipRole {
  OWNER
  MANAGER
}

enum BusinessMembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum BusinessPermission {
  BUSINESS_PROFILE_EDIT
  BUSINESS_HOURS_EDIT
  CATALOG_EDIT
  PHOTOS_EDIT
  PROMOTIONS_EDIT
  REVIEWS_REPLY
  ANALYTICS_VIEW
  ANALYTICS_EXPORT
  ADS_MANAGE
  PAYMENTS_VIEW
}

enum BusinessInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum BusinessStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum BusinessApplicationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum BusinessOwnershipClaimStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum BusinessOwnershipClaimVerificationMethod {
  MANUAL
}

enum BusinessPlanTier {
  FREE
  BASIC
  PREMIUM
  VIP
}

enum PlanPaymentStatus {
  COMPLETED
  FAILED
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  EXPIRED
  ARCHIVED
}

enum AnalyticsEventType {
  VIEW_BUSINESS
  BUSINESS_IMPRESSION
  SEARCH_PERFORMED
  SEARCH_RESULT_IMPRESSION
  SEARCH_RESULT_OPEN
  CALL_CLICK
  WHATSAPP_CLICK
  ROUTE_CLICK
  WEBSITE_CLICK
  INSTAGRAM_CLICK
  FAVORITE_ADD
  FAVORITE_REMOVE
  PROMOTION_VIEW
  PROMOTION_IMPRESSION
  PROMOTION_ACTION
  CATALOG_ITEM_IMPRESSION
  CATALOG_ITEM_VIEW
  CATALOG_ITEM_ACTION
  REVIEWS_VIEW
  REVIEW_CREATED
  AD_SERVED
  AD_IMPRESSION
  AD_CLICK
  AD_CARD_OPEN
  AD_CALL_CLICK
  AD_WHATSAPP_CLICK
  AD_ROUTE_CLICK
  AD_WEBSITE_CLICK
  AD_INSTAGRAM_CLICK
  AD_PROMOTION_OPEN
}

enum AnalyticsDiscoverySurface {
  HOME_FEED
  HOME_RECOMMENDED
  SEARCH_RESULTS
  CATEGORY_LIST
  MAP_PIN
  NEARBY_LIST
  FAVORITES_LIST
  PROMOTION_LIST
  PROMOTION_DETAIL
  BUSINESS_DETAIL
  DIRECT
  OTHER
}

enum AnalyticsPlatform {
  IOS
  ANDROID
  WEB
  UNKNOWN
}

enum AnalyticsVisitorType {
  NEW
  RETURNING
}

enum AnalyticsDimensionType {
  SOURCE
  SEARCH_QUERY
  PROMOTION
  CATALOG_ITEM
  HOUR
  DISTANCE_BUCKET
  VISITOR_TYPE
}

enum BusinessTrafficSource {
  HOME
  SEARCH
  CATEGORY
  MAP
  PROMOTIONS
  FAVORITES
  AD
  DIRECT
  UNKNOWN
}

enum AudienceDistanceBucket {
  LT_1_KM
  KM_1_3
  KM_3_5
  KM_5_10
  GT_10_KM
  UNKNOWN
}

enum MonetizationProductType {
  BOOST
  TOP_CATEGORY
  PROMOTED_PROMOTION
  FEATURED_BUSINESS
  VIP_BANNER
  PACKAGE
}

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  MANUAL
  KASPI
  HALYK
  FREEDOM_PAY
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum AdCreativeType {
  BANNER
  CARD
}

enum AdCreativeTargetType {
  BUSINESS
  PROMOTION
  EXTERNAL_URL
}

enum AdModerationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum AdCampaignStatus {
  PENDING_MODERATION
  AWAITING_PAYMENT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  REJECTED
}

enum AdInventoryReservationStatus {
  HELD
  CONVERTED
  EXPIRED
  CANCELLED
}

enum CityLaunchStatus {
  COMING_SOON
  LIVE
}

model City {
  id                      String                    @id @default(cuid())
  slug                    String                    @unique
  nameRu                  String
  nameKk                  String?
  countryCode             String                    @default("KZ")
  centerLat               Decimal?                  @db.Decimal(10, 7)
  centerLng               Decimal?                  @db.Decimal(10, 7)
  timezone                String                    @default("Asia/Oral")
  isActive                Boolean                   @default(true)
  launchStatus            CityLaunchStatus          @default(LIVE)
  launchDate              DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  businesses              Business[]
  users                   User[]                    @relation("PreferredCity")
  cityAdmins              User[]                    @relation("ManagedCity")
  categoryCityOrders      CategoryCityOrder[]
  adPlacements            AdPlacement[]
  adPlacementCityConfigs  AdPlacementCityConfig[]
  productPrices           ProductPrice[]
  adCampaigns             AdCampaign[]
  adInventoryReservations AdInventoryReservation[]
  auditLogs               AuditLog[]
  businessApplications    BusinessApplication[]
  analyticsEvents         AnalyticsEvent[]
  featureFlagOverrides    CityFeatureFlagOverride[]
}

model AppReleaseSettings {
  id                    String    @id @default("global")
  maintenanceEnabled    Boolean   @default(false)
  maintenanceMessageRu  String?
  maintenanceMessageKk  String?
  maintenanceEndsAt     DateTime?
  androidMinimumVersion String    @default("1.0.0")
  androidLatestVersion  String    @default("1.0.0")
  androidMinimumBuild   Int?
  androidLatestBuild    Int?
  androidStoreUrl       String?
  iosMinimumVersion     String    @default("1.0.0")
  iosLatestVersion      String    @default("1.0.0")
  iosMinimumBuild       Int?
  iosLatestBuild        Int?
  iosStoreUrl           String?
  configRevision        Int       @default(1)
  updatedAt             DateTime  @updatedAt
  updatedByUserId       String?
}

model FeatureFlagDefinition {
  key            String   @id
  globalEnabled  Boolean  @default(true)
  androidEnabled Boolean?
  iosEnabled     Boolean?
  description    String?
  updatedAt      DateTime @updatedAt
}

model CityFeatureFlagOverride {
  id      String  @id @default(cuid())
  cityId  String
  flagKey String
  enabled Boolean
  city    City    @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([cityId, flagKey])
  @@index([flagKey])
}

model User {
  id                           String                   @id @default(cuid())
  phone                        String?                  @unique
  email                        String?
  name                         String?
  /// Server-owned path e.g. /uploads/{uuid}.webp — never client-supplied URL on PATCH.
  avatarUrl                    String?
  role                         UserRole                 @default(USER)
  isActive                     Boolean                  @default(true)
  preferredCityId              String?
  managedCityId                String?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  preferredCity                City?                    @relation("PreferredCity", fields: [preferredCityId], references: [id], onDelete: SetNull)
  managedCity                  City?                    @relation("ManagedCity", fields: [managedCityId], references: [id], onDelete: SetNull)
  ownedBusinesses              Business[]               @relation("BusinessOwner")
  businessMemberships          BusinessMembership[]
  favorites                    Favorite[]
  reviews                      Review[]
  notifications                Notification[]
  otps                         OtpCode[]
  orders                       Order[]
  sentInvitations              BusinessInvitation[]     @relation("InvitationSender")
  acceptedInvitations          BusinessInvitation[]     @relation("InvitationAcceptor")
  auditLogsAsActor             AuditLog[]               @relation("AuditActor")
  businessApplications         BusinessApplication[]    @relation("ApplicationApplicant")
  reviewedBusinessApplications BusinessApplication[]    @relation("ApplicationReviewer")
  ownershipClaims              BusinessOwnershipClaim[] @relation("ClaimClaimant")
  reviewedOwnershipClaims      BusinessOwnershipClaim[] @relation("ClaimReviewer")
  authIdentities               AuthIdentity[]
  authSessions                 AuthSession[]
}

model AuthSession {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  familyId      String
  rotatedFromId String?
  userAgent     String?
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  lastUsedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model AuthIdentity {
  id             String       @id @default(cuid())
  userId         String
  provider       AuthProvider
  providerUserId String
  email          String?
  emailVerified  Boolean?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
}

model AuthIdentityTombstone {
  id             String       @id @default(cuid())
  provider       AuthProvider
  providerUserId String
  deletedAt      DateTime     @default(now())

  @@unique([provider, providerUserId])
}

enum NotificationType {
  GENERAL
  NEW_REVIEW
  REVIEW_REPLY
  BUSINESS_APPROVED
  BUSINESS_BLOCKED
  NEW_PROMOTION
  PLAN_ACTIVATED
  PLAN_EXPIRED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(GENERAL)
  title     String
  body      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, expiresAt])
}

model Category {
  id                      String                   @id @default(cuid())
  title                   String
  slug                    String                   @unique
  icon                    String?
  sortOrder               Int                      @default(0)
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  businesses              Business[]
  categoryCityOrders      CategoryCityOrder[]
  adPlacements            AdPlacement[]
  productPrices           ProductPrice[]
  adCampaigns             AdCampaign[]
  adInventoryReservations AdInventoryReservation[]
  businessApplications    BusinessApplication[]
  subcategories           Subcategory[]
}

model Subcategory {
  id         String                @id @default(cuid())
  categoryId String
  slug       String
  nameRu     String
  nameKk     String
  icon       String?
  sortOrder  Int                   @default(0)
  isActive   Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  category   Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  businesses BusinessSubcategory[]

  @@unique([categoryId, slug])
  @@index([categoryId, isActive])
}

model BusinessSubcategory {
  businessId    String
  subcategoryId String
  createdAt     DateTime    @default(now())
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)

  @@id([businessId, subcategoryId])
  @@index([subcategoryId])
}

model CategoryCityOrder {
  id         String   @id @default(cuid())
  cityId     String
  categoryId String
  sortOrder  Int      @default(0)
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  city       City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([cityId, categoryId])
  @@index([cityId, sortOrder])
}

model Business {
  id                        String                          @id @default(cuid())
  cityId                    String
  ownerId                   String?
  categoryId                String
  title                     String
  slug                      String                          @unique
  shortDesc                 String?
  description               String?
  address                   String
  latitude                  Decimal?                        @db.Decimal(10, 7)
  longitude                 Decimal?                        @db.Decimal(10, 7)
  phone                     String?
  whatsapp                  String?
  instagram                 String?
  website                   String?
  coverImageUrl             String?
  workHours                 Json?
  status                    BusinessStatus                  @default(PENDING)
  /// @deprecated Legacy manual featured flag — not used for consumer catalog ranking (Stage 4C.1). Admin-only via PATCH /admin/businesses/:id/featured.
  isFeatured                Boolean                         @default(false)
  /// @deprecated Legacy city slot — not used for consumer catalog ranking (Stage 4C.1). Admin-only.
  featuredSlot              Int?
  planTier                  BusinessPlanTier                @default(FREE)
  planExpiresAt             DateTime?
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt
  city                      City                            @relation(fields: [cityId], references: [id], onDelete: Restrict)
  owner                     User?                           @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  category                  Category                        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images                    BusinessImage[]
  serviceMenuGroups         ServiceMenuGroup[]
  serviceItems              ServiceItem[]
  promotions                Promotion[]
  favorites                 Favorite[]
  reviews                   Review[]
  analytics                 AnalyticsEvent[]
  analyticsDailyMetrics     AnalyticsDailyMetric[]
  analyticsDimensionMetrics AnalyticsDailyDimensionMetric[]
  analyticsBusinessVisitors AnalyticsBusinessVisitor[]
  planPayments              PlanPayment[]
  orders                    Order[]
  adCreatives               AdCreative[]
  adCampaigns               AdCampaign[]
  adInventoryReservations   AdInventoryReservation[]
  memberships               BusinessMembership[]
  invitations               BusinessInvitation[]
  auditLogs                 AuditLog[]
  approvedFromApplication   BusinessApplication?            @relation("ApprovedBusinessApplication")
  ownershipClaims           BusinessOwnershipClaim[]
  businessSubcategories     BusinessSubcategory[]

  @@index([cityId, status])
  @@index([categoryId])
}

model BusinessOwnershipClaim {
  id                 String                                   @id @default(cuid())
  businessId         String
  claimantUserId     String
  status             BusinessOwnershipClaimStatus             @default(PENDING)
  verificationMethod BusinessOwnershipClaimVerificationMethod @default(MANUAL)
  claimantMessage    String?
  rejectionReason    String?
  reviewedByUserId   String?
  reviewedAt         DateTime?
  createdAt          DateTime                                 @default(now())
  updatedAt          DateTime                                 @updatedAt
  business           Business                                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  claimant           User                                     @relation("ClaimClaimant", fields: [claimantUserId], references: [id], onDelete: Cascade)
  reviewedBy         User?                                    @relation("ClaimReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([claimantUserId])
  @@index([businessId])
  @@index([status])
  @@index([createdAt])
  @@index([businessId, status, createdAt])
  @@index([claimantUserId, status, createdAt])
}

model BusinessApplication {
  id                 String                    @id @default(cuid())
  applicantUserId    String
  cityId             String
  categoryId         String
  title              String
  shortDesc          String?
  address            String
  phone              String?
  status             BusinessApplicationStatus @default(DRAFT)
  dedupeKey          String
  rejectionReason    String?
  reviewedByUserId   String?
  reviewedAt         DateTime?
  approvedBusinessId String?                   @unique
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  applicant          User                      @relation("ApplicationApplicant", fields: [applicantUserId], references: [id], onDelete: Cascade)
  city               City                      @relation(fields: [cityId], references: [id], onDelete: Restrict)
  category           Category                  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reviewedBy         User?                     @relation("ApplicationReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  approvedBusiness   Business?                 @relation("ApprovedBusinessApplication", fields: [approvedBusinessId], references: [id], onDelete: SetNull)

  @@index([applicantUserId])
  @@index([status])
  @@index([cityId])
  @@index([createdAt])
  @@index([cityId, status, createdAt])
  @@index([dedupeKey])
}

model BusinessMembership {
  id          String                   @id @default(cuid())
  userId      String
  businessId  String
  role        BusinessMembershipRole
  status      BusinessMembershipStatus
  permissions BusinessPermission[]     @default([])
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business    Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@index([businessId, status])
}

model BusinessInvitation {
  id               String                   @id @default(cuid())
  businessId       String
  phone            String?
  email            String?
  tokenHash        String?                  @unique
  permissions      BusinessPermission[]
  status           BusinessInvitationStatus @default(PENDING)
  invitedByUserId  String
  acceptedByUserId String?
  acceptedAt       DateTime?
  expiresAt        DateTime
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  business         Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy        User                     @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy       User?                    @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([businessId, phone])
  @@index([businessId, email])
  @@index([phone, status])
  @@index([email, status])
}

model BusinessImage {
  id         String   @id @default(cuid())
  businessId String
  imageUrl   String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model ServiceMenuGroup {
  id          String        @id @default(cuid())
  businessId  String
  title       String
  description String?
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items       ServiceItem[]

  @@index([businessId, isActive])
}

model ServiceItem {
  id              String            @id @default(cuid())
  businessId      String
  groupId         String?
  title           String
  description     String?
  price           Decimal?          @db.Decimal(10, 2)
  imageUrl        String?
  isActive        Boolean           @default(true)
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  group           ServiceMenuGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  analyticsEvents AnalyticsEvent[]

  @@index([businessId, groupId])
}

model Promotion {
  id                      String                   @id @default(cuid())
  businessId              String
  title                   String
  description             String?
  imageUrl                String?
  discountText            String?
  startDate               DateTime?
  endDate                 DateTime?
  status                  PromotionStatus          @default(DRAFT)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  business                Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  analyticsEvents         AnalyticsEvent[]
  adCampaigns             AdCampaign[]
  adInventoryReservations AdInventoryReservation[]
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  rating     Int
  text       String?
  ownerReply String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model AnalyticsEvent {
  id                     String                     @id @default(cuid())
  businessId             String?
  cityId                 String?
  userId                 String?
  type                   AnalyticsEventType
  trafficSource          BusinessTrafficSource?
  discoverySurface       AnalyticsDiscoverySurface?
  searchQuery            String?
  audienceDistanceBucket AudienceDistanceBucket?
  promotionId            String?
  catalogItemId          String?
  categoryId             String?
  position               Int?
  platform               AnalyticsPlatform?
  visitorHash            String?
  visitorType            AnalyticsVisitorType?
  sessionId              String?
  clientEventId          String?                    @unique
  isInternal             Boolean                    @default(false)
  campaignId             String?
  placementId            String?
  createdAt              DateTime                   @default(now())
  business               Business?                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  city                   City?                      @relation(fields: [cityId], references: [id], onDelete: SetNull)
  promotion              Promotion?                 @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  catalogItem            ServiceItem?               @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  campaign               AdCampaign?                @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  placement              AdPlacement?               @relation(fields: [placementId], references: [id], onDelete: SetNull)

  @@index([businessId, type])
  @@index([businessId, type, trafficSource])
  @@index([businessId, type, createdAt])
  @@index([businessId, createdAt])
  @@index([cityId, createdAt])
  @@index([type, createdAt])
  @@index([promotionId])
  @@index([catalogItemId])
  @@index([campaignId])
  @@index([placementId])
  @@index([sessionId])
  @@index([visitorHash])
  @@index([createdAt])
}

model AnalyticsDailyMetric {
  id                   String   @id @default(cuid())
  businessId           String
  metricDate           String
  impressions          Int      @default(0)
  views                Int      @default(0)
  callClicks           Int      @default(0)
  whatsappClicks       Int      @default(0)
  routeClicks          Int      @default(0)
  websiteClicks        Int      @default(0)
  instagramClicks      Int      @default(0)
  favoriteAdds         Int      @default(0)
  promotionImpressions Int      @default(0)
  promotionViews       Int      @default(0)
  promotionActions     Int      @default(0)
  catalogImpressions   Int      @default(0)
  catalogViews         Int      @default(0)
  catalogActions       Int      @default(0)
  reviewsViews         Int      @default(0)
  reviewsCreated       Int      @default(0)
  searchImpressions    Int      @default(0)
  searchOpens          Int      @default(0)
  sessionsApprox       Int      @default(0)
  uniqueVisitorsApprox Int      @default(0)
  updatedAt            DateTime @updatedAt
  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, metricDate])
  @@index([businessId, metricDate])
}

/// Privacy-safe first-seen state for new/returning visitor aggregates (hashed visitor only).
model AnalyticsBusinessVisitor {
  id          String   @id @default(cuid())
  businessId  String
  visitorHash String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, visitorHash])
  @@index([businessId])
}

model AnalyticsDailyDimensionMetric {
  id            String                 @id @default(cuid())
  businessId    String
  metricDate    String
  dimensionType AnalyticsDimensionType
  dimensionKey  String
  metricKey     String
  count         Int                    @default(0)
  updatedAt     DateTime               @updatedAt
  business      Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, metricDate, dimensionType, dimensionKey, metricKey])
  @@index([businessId, metricDate, dimensionType])
}

model PlanPayment {
  id         String            @id @default(cuid())
  businessId String
  tier       BusinessPlanTier
  amountKzt  Int               @default(0)
  status     PlanPaymentStatus @default(COMPLETED)
  isMock     Boolean           @default(true)
  paidAt     DateTime          @default(now())
  expiresAt  DateTime?
  createdAt  DateTime          @default(now())
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, paidAt])
}

// ---------------------------------------------------------------------------
// Campaign-based advertising & monetization (Stage 1 — schema only)
// Coexists with Business.planTier / isFeatured / PlanPayment (legacy).
// ---------------------------------------------------------------------------

model AdPlacement {
  id                    String                   @id @default(cuid())
  code                  String                   @unique
  name                  String
  description           String?
  cityId                String?
  categoryId            String?
  maxVisible            Int                      @default(1)
  maxActiveCampaigns    Int                      @default(10)
  isActive              Boolean                  @default(true)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  city                  City?                    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  category              Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  campaignPlacements    AdCampaignPlacement[]
  productPrices         ProductPrice[]
  analyticsEvents       AnalyticsEvent[]
  cityConfigs           AdPlacementCityConfig[]
  inventoryReservations AdInventoryReservation[]

  @@index([cityId, isActive])
  @@index([categoryId, isActive])
}

model AdPlacementCityConfig {
  id                 String      @id @default(cuid())
  placementId        String
  cityId             String
  maxActiveCampaigns Int?
  isEnabled          Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  placement          AdPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  city               City        @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([placementId, cityId])
  @@index([cityId, isEnabled])
}

model MonetizationProduct {
  id                    String                   @id @default(cuid())
  code                  String                   @unique
  name                  String
  description           String?
  type                  MonetizationProductType
  isActive              Boolean                  @default(true)
  sortOrder             Int                      @default(0)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  prices                ProductPrice[]
  orderItems            OrderItem[]
  adCampaigns           AdCampaign[]
  promotionPackageItems PromotionPackageItem[]
  inventoryReservations AdInventoryReservation[]

  @@index([type, isActive])
}

model ProductPrice {
  id            String              @id @default(cuid())
  productId     String
  cityId        String?
  categoryId    String?
  placementId   String?
  durationHours Int?
  durationDays  Int?
  price         Int
  currency      String              @default("KZT")
  isActive      Boolean             @default(true)
  validFrom     DateTime?
  validUntil    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  product       MonetizationProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  city          City?               @relation(fields: [cityId], references: [id], onDelete: SetNull)
  category      Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  placement     AdPlacement?        @relation(fields: [placementId], references: [id], onDelete: SetNull)

  @@index([productId, isActive])
  @@index([cityId, categoryId, isActive])
}

model Order {
  id                    String                   @id @default(cuid())
  orderNumber           String                   @unique
  businessId            String
  userId                String?
  status                OrderStatus              @default(DRAFT)
  currency              String                   @default("KZT")
  subtotal              Int                      @default(0)
  discountAmount        Int                      @default(0)
  totalAmount           Int                      @default(0)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  paidAt                DateTime?
  cancelledAt           DateTime?
  business              Business                 @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user                  User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  payments              Payment[]
  inventoryReservations AdInventoryReservation[]

  @@index([businessId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                    String                   @id @default(cuid())
  orderId               String
  productId             String
  quantity              Int                      @default(1)
  basePrice             Int
  discountPercent       Int                      @default(0)
  discountAmount        Int                      @default(0)
  finalPrice            Int
  durationHours         Int?
  durationDays          Int?
  metadata              Json?
  packageSnapshot       Json?
  lineSnapshot          Json?
  createdAt             DateTime                 @default(now())
  order                 Order                    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product               MonetizationProduct      @relation(fields: [productId], references: [id], onDelete: Restrict)
  adCampaigns           AdCampaign[]
  inventoryReservations AdInventoryReservation[]

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider @default(MANUAL)
  providerPaymentId String?
  idempotencyKey    String?         @unique
  amount            Int
  currency          String          @default("KZT")
  status            PaymentStatus   @default(PENDING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  paidAt            DateTime?
  failedAt          DateTime?
  refundedAt        DateTime?
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status])
  @@index([providerPaymentId])
}

model AdCreative {
  id                String               @id @default(cuid())
  businessId        String
  type              AdCreativeType       @default(BANNER)
  imageUrl          String?
  title             String
  description       String?
  buttonText        String?
  targetType        AdCreativeTargetType @default(BUSINESS)
  targetId          String?
  targetUrl         String?
  moderationStatus  AdModerationStatus   @default(DRAFT)
  moderationComment String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  business          Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  campaigns         AdCampaign[]

  @@index([businessId])
  @@index([moderationStatus])
}

model AdInventoryReservation {
  id          String                       @id @default(cuid())
  orderId     String
  orderItemId String?
  businessId  String
  cityId      String
  placementId String
  categoryId  String?
  promotionId String?
  productId   String
  startAt     DateTime
  endAt       DateTime
  status      AdInventoryReservationStatus @default(HELD)
  expiresAt   DateTime
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt
  order       Order                        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem?                   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  business    Business                     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  city        City                         @relation(fields: [cityId], references: [id], onDelete: Restrict)
  placement   AdPlacement                  @relation(fields: [placementId], references: [id], onDelete: Restrict)
  category    Category?                    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  promotion   Promotion?                   @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  product     MonetizationProduct          @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([orderItemId])
  @@index([placementId, cityId, status, expiresAt])
  @@index([status, expiresAt])
  @@index([businessId, placementId, status])
}

model AdCampaign {
  id                   String                @id @default(cuid())
  businessId           String
  orderItemId          String?
  productId            String
  creativeId           String?
  promotionId          String?
  cityId               String
  categoryId           String?
  status               AdCampaignStatus      @default(PENDING_MODERATION)
  startAt              DateTime
  endAt                DateTime
  weight               Int                   @default(1)
  servedCount          Int                   @default(0)
  qualifiedImpressions Int                   @default(0)
  clickCount           Int                   @default(0)
  lastShownAt          DateTime?
  lastTopPositionAt    DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  business             Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  orderItem            OrderItem?            @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  product              MonetizationProduct   @relation(fields: [productId], references: [id], onDelete: Restrict)
  creative             AdCreative?           @relation(fields: [creativeId], references: [id], onDelete: SetNull)
  promotion            Promotion?            @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  city                 City                  @relation(fields: [cityId], references: [id], onDelete: Restrict)
  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  campaignPlacements   AdCampaignPlacement[]
  analyticsEvents      AnalyticsEvent[]

  @@index([status])
  @@index([cityId])
  @@index([categoryId])
  @@index([promotionId])
  @@index([productId])
  @@index([startAt])
  @@index([endAt])
  @@index([businessId, status])
}

model AdCampaignPlacement {
  id          String      @id @default(cuid())
  campaignId  String
  placementId String
  weight      Int         @default(1)
  createdAt   DateTime    @default(now())
  campaign    AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  placement   AdPlacement @relation(fields: [placementId], references: [id], onDelete: Restrict)

  @@unique([campaignId, placementId])
  @@index([placementId])
}

model PromotionPackage {
  id           String                 @id @default(cuid())
  code         String                 @unique
  name         String
  description  String?
  price        Int?
  currency     String                 @default("KZT")
  durationDays Int?
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  items        PromotionPackageItem[]

  @@index([isActive])
}

model PromotionPackageItem {
  id            String              @id @default(cuid())
  packageId     String
  productId     String
  durationDays  Int?
  durationHours Int?
  quantity      Int                 @default(1)
  package       PromotionPackage    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  product       MonetizationProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([packageId])
  @@index([productId])
}

enum AuditAction {
  TEAM_INVITE
  TEAM_INVITATION_ACCEPT
  TEAM_PERMISSION_UPDATE
  TEAM_SUSPEND
  TEAM_RESTORE
  TEAM_REVOKE

  BUSINESS_PROFILE_UPDATE
  BUSINESS_HOURS_UPDATE

  CATALOG_ITEM_CREATE
  CATALOG_ITEM_UPDATE
  CATALOG_ITEM_DELETE
  CATALOG_SECTION_CREATE
  CATALOG_SECTION_UPDATE
  CATALOG_SECTION_DELETE

  BUSINESS_PHOTO_ADD
  BUSINESS_PHOTO_DELETE
  BUSINESS_COVER_CHANGE

  PROMOTION_CREATE
  PROMOTION_UPDATE
  PROMOTION_DELETE

  REVIEW_REPLY_CREATE

  PLAN_CHECKOUT
  PLAN_OVERRIDE

  AD_ORDER_CREATE
  AD_CREATIVE_CREATE
  AD_CREATIVE_APPROVE
  AD_CREATIVE_REJECT
  AD_CAMPAIGN_PAUSE
  AD_CAMPAIGN_ACTIVATE

  PAYMENT_CONFIRM

  USER_ROLE_CHANGE

  CITY_CREATE
  CITY_UPDATE
  CITY_LAUNCH_STATUS_CHANGE

  CATEGORY_CREATE
  CATEGORY_UPDATE
  CATEGORY_DELETE

  BUSINESS_APPLICATION_SUBMIT
  BUSINESS_APPLICATION_APPROVE
  BUSINESS_APPLICATION_REJECT
  BUSINESS_APPLICATION_CANCEL

  BUSINESS_OWNERSHIP_CLAIM_SUBMIT
  BUSINESS_OWNERSHIP_CLAIM_APPROVE
  BUSINESS_OWNERSHIP_CLAIM_REJECT
  BUSINESS_OWNERSHIP_CLAIM_CANCEL

  RELEASE_CONFIG_UPDATE
}

enum AuditResourceType {
  USER
  BUSINESS
  BUSINESS_MEMBERSHIP
  BUSINESS_INVITATION
  BUSINESS_APPLICATION
  BUSINESS_OWNERSHIP_CLAIM
  SERVICE_ITEM
  SERVICE_MENU_GROUP
  BUSINESS_IMAGE
  PROMOTION
  PLAN
  ORDER
  PAYMENT
  AD_CAMPAIGN
  AD_CREATIVE
  CITY
  CATEGORY
  REVIEW
  APP_RELEASE_CONFIG
}

model AuditLog {
  id           String            @id @default(cuid())
  actorUserId  String?
  actorRole    UserRole?
  action       AuditAction
  resourceType AuditResourceType
  resourceId   String?
  businessId   String?
  cityId       String?
  targetUserId String?
  metadata     Json?
  createdAt    DateTime          @default(now())
  actor        User?             @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  business     Business?         @relation(fields: [businessId], references: [id], onDelete: SetNull)
  city         City?             @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId])
  @@index([action])
  @@index([resourceType])
  @@index([businessId])
  @@index([cityId])
  @@index([businessId, createdAt])
  @@index([cityId, createdAt])
}
