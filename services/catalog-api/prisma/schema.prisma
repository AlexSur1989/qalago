generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  BUSINESS
  CITY_ADMIN
  ADMIN
}

enum BusinessMembershipRole {
  OWNER
  MANAGER
}

enum BusinessMembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum BusinessPermission {
  BUSINESS_PROFILE_EDIT
  BUSINESS_HOURS_EDIT
  CATALOG_EDIT
  PHOTOS_EDIT
  PROMOTIONS_EDIT
  REVIEWS_REPLY
  ANALYTICS_VIEW
  ANALYTICS_EXPORT
  ADS_MANAGE
  PAYMENTS_VIEW
}

enum BusinessInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum BusinessStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum BusinessPlanTier {
  FREE
  BASIC
  PREMIUM
  VIP
}

enum PlanPaymentStatus {
  COMPLETED
  FAILED
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  EXPIRED
  ARCHIVED
}

enum AnalyticsEventType {
  VIEW_BUSINESS
  CALL_CLICK
  WHATSAPP_CLICK
  ROUTE_CLICK
  WEBSITE_CLICK
  INSTAGRAM_CLICK
  FAVORITE_ADD
  FAVORITE_REMOVE
  PROMOTION_VIEW
  AD_SERVED
  AD_IMPRESSION
  AD_CLICK
  AD_CARD_OPEN
  AD_CALL_CLICK
  AD_WHATSAPP_CLICK
  AD_ROUTE_CLICK
  AD_WEBSITE_CLICK
  AD_INSTAGRAM_CLICK
  AD_PROMOTION_OPEN
}

enum BusinessTrafficSource {
  HOME
  SEARCH
  CATEGORY
  MAP
  PROMOTIONS
  FAVORITES
  AD
  DIRECT
  UNKNOWN
}

enum AudienceDistanceBucket {
  LT_1_KM
  KM_1_3
  KM_3_5
  KM_5_10
  GT_10_KM
  UNKNOWN
}

enum MonetizationProductType {
  BOOST
  TOP_CATEGORY
  PROMOTED_PROMOTION
  FEATURED_BUSINESS
  VIP_BANNER
  PACKAGE
}

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  MANUAL
  KASPI
  HALYK
  FREEDOM_PAY
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum AdCreativeType {
  BANNER
  CARD
}

enum AdCreativeTargetType {
  BUSINESS
  PROMOTION
  EXTERNAL_URL
}

enum AdModerationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum AdCampaignStatus {
  PENDING_MODERATION
  AWAITING_PAYMENT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  REJECTED
}

enum CityLaunchStatus {
  COMING_SOON
  LIVE
}

model City {
  id                 String              @id @default(cuid())
  slug               String              @unique
  nameRu             String
  nameKk             String?
  countryCode        String              @default("KZ")
  centerLat          Decimal?            @db.Decimal(10, 7)
  centerLng          Decimal?            @db.Decimal(10, 7)
  timezone           String              @default("Asia/Oral")
  isActive           Boolean             @default(true)
  launchStatus       CityLaunchStatus    @default(LIVE)
  launchDate         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  businesses         Business[]
  users              User[]              @relation("PreferredCity")
  cityAdmins         User[]              @relation("ManagedCity")
  categoryCityOrders CategoryCityOrder[]
  adPlacements       AdPlacement[]
  productPrices      ProductPrice[]
  adCampaigns        AdCampaign[]
  auditLogs          AuditLog[]
}

model User {
  id              String         @id @default(cuid())
  phone           String         @unique
  name            String?
  role            UserRole       @default(USER)
  isActive        Boolean        @default(true)
  preferredCityId String?
  managedCityId   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  preferredCity   City?          @relation("PreferredCity", fields: [preferredCityId], references: [id], onDelete: SetNull)
  managedCity     City?          @relation("ManagedCity", fields: [managedCityId], references: [id], onDelete: SetNull)
  ownedBusinesses     Business[]           @relation("BusinessOwner")
  businessMemberships BusinessMembership[]
  favorites             Favorite[]
  reviews         Review[]
  notifications   Notification[]
  otps            OtpCode[]
  orders          Order[]
  sentInvitations BusinessInvitation[] @relation("InvitationSender")
  auditLogsAsActor  AuditLog[]           @relation("AuditActor")
}

enum NotificationType {
  GENERAL
  NEW_REVIEW
  REVIEW_REPLY
  BUSINESS_APPROVED
  BUSINESS_BLOCKED
  NEW_PROMOTION
  PLAN_ACTIVATED
  PLAN_EXPIRED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(GENERAL)
  title     String
  body      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, expiresAt])
}

model Category {
  id                 String              @id @default(cuid())
  title              String
  slug               String              @unique
  icon               String?
  sortOrder          Int                 @default(0)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  businesses         Business[]
  categoryCityOrders CategoryCityOrder[]
  adPlacements       AdPlacement[]
  productPrices      ProductPrice[]
  adCampaigns        AdCampaign[]
}

model CategoryCityOrder {
  id         String   @id @default(cuid())
  cityId     String
  categoryId String
  sortOrder  Int      @default(0)
  isHidden   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  city       City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([cityId, categoryId])
  @@index([cityId, sortOrder])
}

model Business {
  id                String             @id @default(cuid())
  cityId            String
  ownerId           String?
  categoryId        String
  title             String
  slug              String             @unique
  shortDesc         String?
  description       String?
  address           String
  latitude          Decimal?           @db.Decimal(10, 7)
  longitude         Decimal?           @db.Decimal(10, 7)
  phone             String?
  whatsapp          String?
  instagram         String?
  website           String?
  coverImageUrl     String?
  workHours         Json?
  status            BusinessStatus     @default(PENDING)
  /// @deprecated Legacy manual featured flag — not used for consumer catalog ranking (Stage 4C.1). Admin-only via PATCH /admin/businesses/:id/featured.
  isFeatured        Boolean            @default(false)
  /// @deprecated Legacy city slot — not used for consumer catalog ranking (Stage 4C.1). Admin-only.
  featuredSlot      Int?
  planTier          BusinessPlanTier   @default(FREE)
  planExpiresAt     DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  city              City               @relation(fields: [cityId], references: [id], onDelete: Restrict)
  owner             User?              @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images            BusinessImage[]
  serviceMenuGroups ServiceMenuGroup[]
  serviceItems      ServiceItem[]
  promotions        Promotion[]
  favorites         Favorite[]
  reviews           Review[]
  analytics         AnalyticsEvent[]
  planPayments      PlanPayment[]
  orders            Order[]
  adCreatives       AdCreative[]
  adCampaigns       AdCampaign[]
  memberships       BusinessMembership[]
  invitations       BusinessInvitation[]
  auditLogs         AuditLog[]

  @@index([cityId, status])
  @@index([categoryId])
}

model BusinessMembership {
  id          String                   @id @default(cuid())
  userId      String
  businessId  String
  role        BusinessMembershipRole
  status      BusinessMembershipStatus
  permissions BusinessPermission[]     @default([])
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business    Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@index([businessId, status])
}

model BusinessInvitation {
  id              String                   @id @default(cuid())
  businessId      String
  phone           String
  permissions     BusinessPermission[]
  status          BusinessInvitationStatus @default(PENDING)
  invitedByUserId String
  expiresAt       DateTime
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  business        Business                 @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy       User                     @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([businessId, phone])
  @@index([phone, status])
}

model BusinessImage {
  id         String   @id @default(cuid())
  businessId String
  imageUrl   String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model ServiceMenuGroup {
  id          String        @id @default(cuid())
  businessId  String
  title       String
  description String?
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  items       ServiceItem[]

  @@index([businessId, isActive])
}

model ServiceItem {
  id          String            @id @default(cuid())
  businessId  String
  groupId     String?
  title       String
  description String?
  price       Decimal?          @db.Decimal(10, 2)
  imageUrl    String?
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  business    Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  group       ServiceMenuGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([businessId, groupId])
}

model Promotion {
  id           String          @id @default(cuid())
  businessId   String
  title        String
  description  String?
  imageUrl     String?
  discountText String?
  startDate    DateTime?
  endDate      DateTime?
  status       PromotionStatus @default(DRAFT)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  rating     Int
  text       String?
  ownerReply String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model AnalyticsEvent {
  id            String                  @id @default(cuid())
  businessId    String
  userId        String?
  type          AnalyticsEventType
  trafficSource          BusinessTrafficSource?
  searchQuery            String?
  audienceDistanceBucket AudienceDistanceBucket?
  campaignId             String?
  placementId   String?
  sessionId     String?
  createdAt     DateTime                @default(now())
  business      Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign      AdCampaign?             @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  placement     AdPlacement?            @relation(fields: [placementId], references: [id], onDelete: SetNull)

  @@index([businessId, type])
  @@index([businessId, type, trafficSource])
  @@index([businessId, type, createdAt])
  @@index([campaignId])
  @@index([placementId])
  @@index([sessionId])
  @@index([createdAt])
}

model PlanPayment {
  id         String            @id @default(cuid())
  businessId String
  tier       BusinessPlanTier
  amountKzt  Int               @default(0)
  status     PlanPaymentStatus @default(COMPLETED)
  isMock     Boolean           @default(true)
  paidAt     DateTime          @default(now())
  expiresAt  DateTime?
  createdAt  DateTime          @default(now())
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, paidAt])
}

// ---------------------------------------------------------------------------
// Campaign-based advertising & monetization (Stage 1 — schema only)
// Coexists with Business.planTier / isFeatured / PlanPayment (legacy).
// ---------------------------------------------------------------------------

model AdPlacement {
  id                 String                @id @default(cuid())
  code               String                @unique
  name               String
  description        String?
  cityId             String?
  categoryId         String?
  maxVisible         Int                   @default(1)
  maxActiveCampaigns Int                   @default(10)
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  city               City?                 @relation(fields: [cityId], references: [id], onDelete: SetNull)
  category           Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  campaignPlacements AdCampaignPlacement[]
  productPrices      ProductPrice[]
  analyticsEvents    AnalyticsEvent[]

  @@index([cityId, isActive])
  @@index([categoryId, isActive])
}

model MonetizationProduct {
  id                    String                  @id @default(cuid())
  code                  String                  @unique
  name                  String
  description           String?
  type                  MonetizationProductType
  isActive              Boolean                 @default(true)
  sortOrder             Int                     @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  prices                ProductPrice[]
  orderItems            OrderItem[]
  adCampaigns           AdCampaign[]
  promotionPackageItems PromotionPackageItem[]

  @@index([type, isActive])
}

model ProductPrice {
  id            String              @id @default(cuid())
  productId     String
  cityId        String?
  categoryId    String?
  placementId   String?
  durationHours Int?
  durationDays  Int?
  price         Int
  currency      String              @default("KZT")
  isActive      Boolean             @default(true)
  validFrom     DateTime?
  validUntil    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  product       MonetizationProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  city          City?               @relation(fields: [cityId], references: [id], onDelete: SetNull)
  category      Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  placement     AdPlacement?        @relation(fields: [placementId], references: [id], onDelete: SetNull)

  @@index([productId, isActive])
  @@index([cityId, categoryId, isActive])
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  businessId     String
  userId         String?
  status         OrderStatus @default(DRAFT)
  currency       String      @default("KZT")
  subtotal       Int         @default(0)
  discountAmount Int         @default(0)
  totalAmount    Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  paidAt         DateTime?
  cancelledAt    DateTime?
  business       Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  payments       Payment[]

  @@index([businessId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id              String              @id @default(cuid())
  orderId         String
  productId       String
  quantity        Int                 @default(1)
  basePrice       Int
  discountPercent Int                 @default(0)
  discountAmount  Int                 @default(0)
  finalPrice      Int
  durationHours   Int?
  durationDays    Int?
  metadata        Json?
  createdAt       DateTime            @default(now())
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product         MonetizationProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  adCampaigns     AdCampaign[]

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider @default(MANUAL)
  providerPaymentId String?
  idempotencyKey    String?         @unique
  amount            Int
  currency          String          @default("KZT")
  status            PaymentStatus   @default(PENDING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  paidAt            DateTime?
  failedAt          DateTime?
  refundedAt        DateTime?
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status])
  @@index([providerPaymentId])
}

model AdCreative {
  id                String               @id @default(cuid())
  businessId        String
  type              AdCreativeType       @default(BANNER)
  imageUrl          String?
  title             String
  description       String?
  buttonText        String?
  targetType        AdCreativeTargetType @default(BUSINESS)
  targetId          String?
  targetUrl         String?
  moderationStatus  AdModerationStatus   @default(DRAFT)
  moderationComment String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  business          Business             @relation(fields: [businessId], references: [id], onDelete: Restrict)
  campaigns         AdCampaign[]

  @@index([businessId])
  @@index([moderationStatus])
}

model AdCampaign {
  id                   String                @id @default(cuid())
  businessId           String
  orderItemId          String?
  productId            String
  creativeId           String?
  cityId               String
  categoryId           String?
  status               AdCampaignStatus      @default(PENDING_MODERATION)
  startAt              DateTime
  endAt                DateTime
  weight               Int                   @default(1)
  servedCount          Int                   @default(0)
  qualifiedImpressions Int                   @default(0)
  clickCount           Int                   @default(0)
  lastShownAt          DateTime?
  lastTopPositionAt    DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  business             Business              @relation(fields: [businessId], references: [id], onDelete: Restrict)
  orderItem            OrderItem?            @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  product              MonetizationProduct   @relation(fields: [productId], references: [id], onDelete: Restrict)
  creative             AdCreative?           @relation(fields: [creativeId], references: [id], onDelete: SetNull)
  city                 City                  @relation(fields: [cityId], references: [id], onDelete: Restrict)
  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  campaignPlacements   AdCampaignPlacement[]
  analyticsEvents      AnalyticsEvent[]

  @@index([status])
  @@index([cityId])
  @@index([categoryId])
  @@index([productId])
  @@index([startAt])
  @@index([endAt])
  @@index([businessId, status])
}

model AdCampaignPlacement {
  id          String      @id @default(cuid())
  campaignId  String
  placementId String
  weight      Int         @default(1)
  createdAt   DateTime    @default(now())
  campaign    AdCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  placement   AdPlacement @relation(fields: [placementId], references: [id], onDelete: Restrict)

  @@unique([campaignId, placementId])
  @@index([placementId])
}

model PromotionPackage {
  id           String                 @id @default(cuid())
  code         String                 @unique
  name         String
  description  String?
  price        Int?
  currency     String                 @default("KZT")
  durationDays Int?
  isActive     Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  items        PromotionPackageItem[]

  @@index([isActive])
}

model PromotionPackageItem {
  id            String              @id @default(cuid())
  packageId     String
  productId     String
  durationDays  Int?
  durationHours Int?
  quantity      Int                 @default(1)
  package       PromotionPackage    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  product       MonetizationProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([packageId])
  @@index([productId])
}

enum AuditAction {
  TEAM_INVITE
  TEAM_INVITATION_ACCEPT
  TEAM_PERMISSION_UPDATE
  TEAM_SUSPEND
  TEAM_RESTORE
  TEAM_REVOKE

  BUSINESS_PROFILE_UPDATE
  BUSINESS_HOURS_UPDATE

  CATALOG_ITEM_CREATE
  CATALOG_ITEM_UPDATE
  CATALOG_ITEM_DELETE
  CATALOG_SECTION_CREATE
  CATALOG_SECTION_UPDATE
  CATALOG_SECTION_DELETE

  BUSINESS_PHOTO_ADD
  BUSINESS_PHOTO_DELETE
  BUSINESS_COVER_CHANGE

  PROMOTION_CREATE
  PROMOTION_UPDATE
  PROMOTION_DELETE

  REVIEW_REPLY_CREATE

  PLAN_CHECKOUT
  PLAN_OVERRIDE

  AD_ORDER_CREATE
  AD_CREATIVE_CREATE
  AD_CREATIVE_APPROVE
  AD_CREATIVE_REJECT
  AD_CAMPAIGN_PAUSE
  AD_CAMPAIGN_ACTIVATE

  PAYMENT_CONFIRM

  USER_ROLE_CHANGE

  CITY_CREATE
  CITY_UPDATE
  CITY_LAUNCH_STATUS_CHANGE

  CATEGORY_CREATE
  CATEGORY_UPDATE
  CATEGORY_DELETE
}

enum AuditResourceType {
  USER
  BUSINESS
  BUSINESS_MEMBERSHIP
  BUSINESS_INVITATION
  SERVICE_ITEM
  SERVICE_MENU_GROUP
  BUSINESS_IMAGE
  PROMOTION
  PLAN
  ORDER
  PAYMENT
  AD_CAMPAIGN
  AD_CREATIVE
  CITY
  CATEGORY
  REVIEW
}

model AuditLog {
  id           String            @id @default(cuid())
  actorUserId  String?
  actorRole    UserRole?
  action       AuditAction
  resourceType AuditResourceType
  resourceId   String?
  businessId   String?
  cityId       String?
  targetUserId String?
  metadata     Json?
  createdAt    DateTime          @default(now())
  actor        User?             @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  business     Business?         @relation(fields: [businessId], references: [id], onDelete: SetNull)
  city         City?             @relation(fields: [cityId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId])
  @@index([action])
  @@index([resourceType])
  @@index([businessId])
  @@index([cityId])
  @@index([businessId, createdAt])
  @@index([cityId, createdAt])
}
